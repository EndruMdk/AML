<tbody>
<tr><td>open</td><td>http://127.0.0.1:8000/accounts/login/<datalist><option>http://127.0.0.1:8000/accounts/login/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>link=exact:Nemate nalog? Registracija<datalist><option>link=exact:Nemate nalog? Registracija</option><option>xpath=//a[contains(text(),'Nemate nalog? Registracija')]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Login'])[1]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Lozinka'])[1]/following::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Zaboravljena lozinka?'])[1]/preceding::a[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Katalon Recorder is recording ...'])[1]/preceding::a[2]</option><option>xpath=//*/text()[normalize-space(.)='Nemate nalog? Registracija']/parent::*</option><option>xpath=//a[contains(@href, '/accounts/register/')]</option><option>xpath=//a</option><option>css=a.btn.btn-link</option></datalist></td><td></td></tr>
<tr><td>open</td><td>http://127.0.0.1:8000/accounts/register/<datalist><option>http://127.0.0.1:8000/accounts/register/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=id_first_name<datalist><option>id=id_first_name</option><option>name=first_name</option><option>xpath=//input[@id='id_first_name']</option><option>xpath=//div/input</option><option>css=#id_first_name</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=id_first_name<datalist><option>id=id_first_name</option><option>name=first_name</option><option>xpath=//input[@id='id_first_name']</option><option>xpath=//div/input</option><option>css=#id_first_name</option></datalist></td><td>Pera</td></tr>
<tr><td>type</td><td>id=id_last_name<datalist><option>id=id_last_name</option><option>name=last_name</option><option>xpath=//input[@id='id_last_name']</option><option>xpath=//div[2]/input</option><option>css=#id_last_name</option></datalist></td><td>Peric</td></tr>
<tr><td>type</td><td>id=id_email<datalist><option>id=id_email</option><option>name=email</option><option>xpath=//input[@id='id_email']</option><option>xpath=//div[3]/input</option><option>css=#id_email</option></datalist></td><td>pera1@gmail.com</td></tr>
<tr><td>type</td><td>id=id_username<datalist><option>id=id_username</option><option>name=username</option><option>xpath=//input[@id='id_username']</option><option>xpath=//div[4]/input</option><option>css=#id_username</option></datalist></td><td>pera1</td></tr>
<tr><td>type</td><td>id=id_password<datalist><option>id=id_password</option><option>name=password</option><option>xpath=//input[@id='id_password']</option><option>xpath=//div[5]/input</option><option>css=#id_password</option></datalist></td><td>123</td></tr>
<tr><td>type</td><td>id=id_password_confirm<datalist><option>id=id_password_confirm</option><option>name=password_confirm</option><option>xpath=//input[@id='id_password_confirm']</option><option>xpath=//div[6]/input</option><option>css=#id_password_confirm</option></datalist></td><td>123</td></tr>
<tr><td>click</td><td>name=role<datalist><option>name=role</option><option>xpath=//input[@name='role']</option><option>xpath=//label/input</option><option>css=input[name="role"]</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@type='submit']<datalist><option>xpath=//button[@type='submit']</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='CV (PDF)'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Arbitrator'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Povratak na login'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Katalon Recorder is recording ...'])[1]/preceding::button[1]</option><option>xpath=//button</option><option>css=button.btn.btn-primary</option></datalist></td><td></td></tr>
<tr><td>open</td><td>http://127.0.0.1:8000/accounts/login/<datalist><option>http://127.0.0.1:8000/accounts/login/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Logovanje'])[2]/following::div[2]<datalist><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Logovanje'])[2]/following::div[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Username'])[1]/preceding::div[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Lozinka'])[1]/preceding::div[2]</option><option>xpath=//*/text()[normalize-space(.)='Nalog je uspesno kreiran. Mozete se prijaviti.']/parent::*</option><option>xpath=//div/div[2]/div</option><option>css=div.message.message--success</option></datalist></td><td></td></tr>
<tr><td>verifyText</td><td>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Logovanje'])[2]/following::div[2]<datalist><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Logovanje'])[2]/following::div[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Username'])[1]/preceding::div[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Lozinka'])[1]/preceding::div[2]</option><option>xpath=//*/text()[normalize-space(.)='Nalog je uspesno kreiran. Mozete se prijaviti.']/parent::*</option><option>xpath=//div/div[2]/div</option><option>css=div.message.message--success</option></datalist></td><td>Nalog je uspesno kreiran. Mozete se prijaviti.</td></tr>
